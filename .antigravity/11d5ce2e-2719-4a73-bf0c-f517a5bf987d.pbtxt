        target_content: "import React, { useEffect } from \'react\';\nimport { MapPin, Phone, Mail, Clock, ShieldCheck } from \'lucide-react\';\nimport { COMPANY_INFO } from \'../data/hvacData\';\nimport { BookingFormData } from \'../types\';\n\ninterface BottomBookingSectionProps {\n  initialPromoCode?: string;\n  initialServiceType?: string;\n  initialNotes?: string;\n  onBookingSuccess?: (bookingData: BookingFormData) => void;\n}\n\nexport const BottomBookingSection: React.FC<BottomBookingSectionProps> = () => {\n  // Load LeadConnector form resize script\n  useEffect(() => {\n    const scriptId = \'leadconnector-form-script\';\n    if (!document.getElementById(scriptId)) {\n      const script = document.createElement(\'script\');\n      script.id = scriptId;\n      script.src = \'https://link.msgsndr.com/js/form_embed.js\';\n      script.async = true;\n      document.body.appendChild(script);\n    }\n  }, []);\n\n  return (\n    <section id=\"bottom-booking-section\" className=\"py-16 sm:py-20 bg-slate-900 text-white relative overflow-hidden\">\n      {/* Background ambient accents */}\n      <div className=\"absolute top-0 right-0 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none\" />\n      <div className=\"absolute bottom-0 left-0 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Main 3-Column / Grid layout matching the bottom of reference image */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          \n          {/* Left Column: Company Location & Phone Info */}\n          <div className=\"lg:col-span-3 space-y-6\">\n            <div>\n              <div className=\"flex items-center gap-2 mb-2\">\n                <div className=\"w-8 h-8 rounded-lg bg-cyan-600 flex items-center justify-center text-white font-bold text-base\">\n                  \342\235\204\n                </div>\n                <span className=\"text-xl font-black tracking-tight text-white\">\n                  APEX<span className=\"text-cyan-400\">AIR</span>\n                </span>\n              </div>\n              <p className=\"text-xs text-orange-400 font-bold uppercase tracking-wider\">\n                {COMPANY_INFO.brandSubtitle}\n              </p>\n            </div>\n\n            <div className=\"space-y-4 text-xs sm:text-sm text-slate-300\">\n              <div className=\"flex items-start gap-2.5\">\n                <MapPin className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block\">{COMPANY_INFO.location}</strong>\n                  <span>{COMPANY_INFO.address}</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-2.5\">\n                <Phone className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block\">Direct Dispatch</strong>\n                  <a href={`tel:${COMPANY_INFO.phoneRaw}`} className=\"hover:text-cyan-300 font-bold text-white transition-colors\">\n                    {COMPANY_INFO.phone}\n                  </a>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-2.5\">\n                <Mail className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block\">Email Support</strong>\n                  <span>{COMPANY_INFO.email}</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-2.5\">\n                <Clock className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block\">Emergency Coverage</strong>\n                  <span>24 Hours / 7 Days a Week</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"p-3.5 bg-slate-800/80 rounded-xl border border-slate-700 text-xs text-slate-300 space-y-1\">\n              <div className=\"flex items-center gap-1.5 text-emerald-400 font-bold\">\n                <ShieldCheck className=\"w-4 h-4\" />\n                <span>{COMPANY_INFO.license}</span>\n              </div>\n              <p className=\"text-[11px] text-slate-400\">EPA Universal Section 608 Verified Contractor</p>\n            </div>\n          </div>\n\n          {/* Center Column: Live GoHighLevel / LeadConnector Iframe Form */}\n          <div className=\"lg:col-span-6 bg-white text-slate-900 rounded-2xl p-4 sm:p-6 shadow-2xl border border-slate-200 overflow-hidden\">\n            <div className=\"w-full min-h-[600px] flex items-center justify-center\">\n              <iframe\n                src=\"https://api.leadconnectorhq.com/widget/form/IuF3GzzPgFkaOQzsZzXC\"\n                style={{ width: \'100%\', height: \'100%\', minHeight: \'620px\', border: \'none\', borderRadius: \'8px\' }}\n                id=\"inline-IuF3GzzPgFkaOQzsZzXC\"\n                data-layout=\"{\'id\':\'INLINE\'}\"\n                data-trigger-type=\"alwaysShow\"\n                data-trigger-value=\"\"\n                data-activation-type=\"alwaysActivated\"\n                data-activation-value=\"\"\n                data-deactivation-type=\"neverDeactivate\"\n                data-deactivation-value=\"\"\n                data-form-name=\"HVAC Lead Capture Form\"\n                data-height=\"1301\"\n                data-layout-iframe-id=\"inline-IuF3GzzPgFkaOQzsZzXC\"\n                data-form-id=\"IuF3GzzPgFkaOQzsZzXC\"\n                title=\"HVAC Lead Capture Form\"\n              />\n            </div>\n          </div>\n\n          {/* Right Column: Service Van Graphic + Payment Badges matching reference photo */}\n          <div className=\"lg:col-span-3 flex flex-col items-center lg:items-end justify-between 