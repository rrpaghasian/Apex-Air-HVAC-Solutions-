        target_content: "  <!-- Bottom Booking Form -->\n  <section class=\"bottom-section\" id=\"book\">\n    <div class=\"container\">\n      <div class=\"bottom-grid\">\n        <div>\n          <h3 style=\"font-size: 1.3rem; font-weight: 800; color: #fff;\">Apex Air Solutions</h3>\n          <p style=\"color: #f97316; font-weight: 700; font-size: 0.85rem; margin-bottom: 14px;\">Heating & AC Specialists</p>\n          <p style=\"font-size: 0.85rem; color: #cbd5e1; margin-bottom: 6px;\">\360\237\223\215 7035 Evergreen Way, Buford, GA 30518</p>\n          <p style=\"font-size: 0.85rem; color: #cbd5e1; margin-bottom: 6px;\">\360\237\223\236 Direct: (770) 967-7910</p>\n          <p style=\"font-size: 0.85rem; color: #cbd5e1; margin-bottom: 14px;\">\342\217\260 Open 24/7 for Emergencies</p>\n        </div>\n\n        <div class=\"form-card\" style=\"padding: 16px; overflow: hidden;\">\n          <iframe\n            src=\"https://api.leadconnectorhq.com/widget/form/IuF3GzzPgFkaOQzsZzXC\"\n            style=\"width:100%;height:100%;min-height:600px;border:none;border-radius:8px\"\n            id=\"inline-IuF3GzzPgFkaOQzsZzXC\" \n            data-layout=\"{\'id\':\'INLINE\'}\"\n            data-trigger-type=\"alwaysShow\"\n            data-trigger-value=\"\"\n            data-activation-type=\"alwaysActivated\"\n            data-activation-value=\"\"\n            data-deactivation-type=\"neverDeactivate\"\n            data-deactivation-value=\"\"\n            data-form-name=\"HVAC Lead Capture Form\"\n            data-height=\"1301\"\n            data-layout-iframe-id=\"inline-IuF3GzzPgFkaOQzsZzXC\"\n            data-form-id=\"IuF3GzzPgFkaOQzsZzXC\"\n            title=\"HVAC Lead Capture Form\"\n          >\n          </iframe>\n          <script src=\"https://link.msgsndr.com/js/form_embed.js\"></script>\n        </div>\n\n        <div style=\"text-align: center;\">\n          <div style=\"background: #1e293b; padding: 18px; border-radius: 12px; border: 1px solid #334155; margin-bottom: 16px;\">\n            <div style=\"font-size: 1.8rem; margin-bottom: 6px;\">\360\237\232\220</div>\n            <h4 style=\"font-size: 0.95rem; font-weight: 800;\">Stocked Fleet Trucks</h4>\n            <p style=\"font-size: 0.8rem; color: #94a3b8; margin-top: 4px;\">Universal parts on board for 1-visit fixes.</p>\n          </div>\n          <p style=\"font-size: 0.8rem; color: #94a3b8; margin-bottom: 6px;\">We Accept :)</p>\n          <p style=\"font-weight: 800; font-size: 0.75rem; color: #38bdf8;\">DISCOVER \342\200\242 AMEX \342\200\242 VISA \342\200\242 MASTERCARD</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <footer>\n    <div class=\"container\">\n      <p>&copy; 2026 Apex Air Solutions. All rights reserved. Licensed, Bonded & Insured HVAC Contractors.</p>\n    </div>\n  </footer>"
        replacement_content: "  <!-- Wide Lead Capture Form Section -->\n  <section class=\"bottom-section\" id=\"book\">\n    <div class=\"container\" style=\"max-width: 960px;\">\n      <div style=\"text-align: center; margin-bottom: 24px;\">\n        <span class=\"badge-urgent\" style=\"background: rgba(249,115,22,0.2); color: #f97316; border: 1px solid rgba(249,115,22,0.4); padding: 4px 12px; border-radius: 20px; font-size: 0.75rem;\">\n          Instant Dispatch Window & $25 OFF Applied\n        </span>\n        <h2 style=\"font-size: clamp(1.6rem, 5vw, 2.2rem); font-weight: 900; margin-top: 10px; color: #ffffff;\">\n          Schedule Service or Request an Estimate\n        </h2>\n        <p style=\"font-size: 0.9rem; color: #94a3b8; max-width: 600px; margin: 6px auto 0;\">\n          Fill out the quick form below. Our automated dispatch coordinator will confirm your arrival window in under 2 minutes.\n        </p>\n      </div>\n\n      <div class=\"form-card\" style=\"padding: 20px; overflow: hidden; background: #ffffff; border-radius: 16px; box-shadow: 0 15px 35px rgba(0,0,0,0.3);\">\n        <iframe\n          src=\"https://api.leadconnectorhq.com/widget/form/IuF3GzzPgFkaOQzsZzXC\"\n          style=\"width:100%;height:100%;min-height:540px;border:none;border-radius:8px\"\n          id=\"inline-IuF3GzzPgFkaOQzsZzXC\" \n          data-layout=\"{\'id\':\'INLINE\'}\"\n          data-trigger-type=\"alwaysShow\"\n          data-trigger-value=\"\"\n          data-activation-type=\"alwaysActivated\"\n          data-activation-value=\"\"\n          data-deactivation-type=\"neverDeactivate\"\n          data-deactivation-value=\"\"\n          data-form-name=\"HVAC Lead Capture Form\"\n          data-height=\"1301\"\n          data-layout-iframe-id=\"inline-IuF3GzzPgFkaOQzsZzXC\"\n          data-form-id=\"IuF3GzzPgFkaOQzsZzXC\"\n          title=\"HVAC Lead Capture Form\"\n        >\n        </iframe>\n        <script src=\"https://link.msgsndr.com/js/form_embed.js\"></script>\n\n        <div style=\"margin-top: 14px; padding-top: 12px; border-top: 1px solid #f1f5f9; display: flex; flex-wrap: wrap; justify-content: space-between; font-size: 0.75rem; color: #64748b;\">\n          <span>\360\237\224\222 Zero payment required until diagnostic or service is complete</span>\n          <span style=\"color: #0284c7; font-weight: 700;\">Instant automated SMS dispatch confirmation</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Complete Footer with Company Details & Stocked Fleet Truck -->\n  <footer>\n    <div class=\"container\">\n      <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px; padding: 40px 0 30px; text-align: left; border-bottom: 1px solid #1e293b;\">\n        \n        <!-- Company Info -->\n        <div>\n          <h3 style=\"font-size: 1.35rem; font-weight: 900; color: #fff; margin-bottom: 4px;\">\n            \342\235\204\357\270\217 APEX<span style=\"color: #0284c7;\">AIR</span>\n          </h3>\n          <p style=\"color: #f97316; font-weight: 800; font-size: 0.75rem; text-transform: uppercase; margin-bottom: 16px;\">\n            Heating & AC Specialists\n          </p>\n          <p style=\"font-size: 0.85rem; color: #cbd5e1; margin-bottom: 8px;\">\360\237\223\215 <strong>Buford GA Location:</strong> 7035 Evergreen Way, Buford, GA 30518</p>\n          <p style=\"font-size: 0.85rem; color: #cbd5e1; margin-bottom: 8px;\">\360\237\223\236 <strong>Direct Dispatch:</strong> (770) 967-7910</p>\n          <p style=\"font-size: 0.85rem; color: #cbd5e1; margin-bottom: 8px;\">\342\234\211\357\270\217 <strong>Email Support:</strong> dispatch@apexair.com</p>\n          <p style=\"font-size: 0.85rem; color: #cbd5e1; margin-bottom: 14px;\">\342\217\260 <strong>Emergency Coverage:</strong> 24 Hours / 7 Days a Week</p>\n          \n          <div style=\"background: rgba(255,255,255,0.05); border: 1px solid #334155; padding: 10px 14px; border-radius: 8px; font-size: 0.75rem; color: #4ade80;\">\n            \342\234\224 GA HVAC Master Lic #HVAC-98231 \342\200\242 EPA Universal Section 608 Verified\n          </div>\n        </div>\n\n        <!-- Navigation Links -->\n        <div>\n          <h4 style=\"color: #ffffff; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; margin-bottom: 12px;\">\n            Navigation\n          </h4>\n          <ul style=\"list-style: none; padding: 0; margin: 0; line-height: 2; font-size: 0.85rem;\">\n            <li><a href=\"#services\" style=\"color: #94a3b8; text-decoration: none;\">Our Services</a></li>\n            <li><a href=\"#diagnostics\" style=\"color: #94a3b8; text-decoration: none;\">HVAC Diagnostics Wizard</a></li>\n            <li><a href=\"#seer\" style=\"color: #94a3b8; text-decoration: none;\">SEER Savings Auditor</a></li>\n            <li><a href=\"#maintenance\" style=\"color: #94a3b8; text-decoration: none;\">Comfort Club Maintenance</a></li>\n            <li><a href=\"#coupons\" style=\"color: #94a3b8; text-decoration: none;\">Seasonal Coupons</a></li>\n            <li><a href=\"#book\" style=\"color: #f97316; font-weight: 800; text-decoration: none;\">\360\237\223\205 Book Service Online</a></li>\n          </ul>\n        </div>\n\n        <!-- Stocked Fleet Trucks & Payment Methods -->\n        <div style=\"text-align: center;\">\n          <div style=\"background: #1e293b; padding: 18px; border-radius: 12px; border: 1px solid #334155; margin-bottom: 16px;\">\n            <div style=\"font-size: 1.8rem; margin-bottom: 4px;\">\360\237\232\220</div>\n            <h4 style=\"font-size: 0.95rem; font-weight: 800; color: #fff;\">Stocked Fleet Trucks</h4>\n            <p style=\"font-size: 0.8rem; color: #94a3b8; margin-top: 4px;\">Universal capacitors, fan motors, contactors, and refrigerant on board.</p>\n          </div>\n          <p style=\"font-size: 0.8rem; color: #94a3b8; margin-bottom: 6px;\">We Accept :)</p>\n          <div style=\"display: flex; gap: 6px; justify-content: center; font-weight: 800; font-size: 0.7rem;\">\n            <span style=\"background: #1e293b; color: #f97316; padding: 4px 8px; border-radius: 4px; border: 1px solid #334155;\">DISCOVER</span>\n            <span style=\"background: #1e293b; color: #60a5fa; padding: 4px 8px; border-radius: 4px; border: 1px solid #334155;\">AMEX</span>\n            <span style=\"background: #1e293b; color: #38bdf8; padding: 4px 8px; border-radius: 4px; border: 1px solid #334155;\">VISA</span>\n            <span style=\"background: #1e293b; color: #f87171; padding: 4px 8px; border-radius: 4px; border: 1px solid #334155;\">MASTERCARD</span>\n          </div>\n        </div>\n\n      </div>\n\n      <p style=\"padding: 20px 0; margin: 0;\">&copy; 2026 Apex Air Solutions. All rights reserved. Licensed, Bonded & Insured HVAC Contractors.</p>\n    </div>\n  </footer>"
      }
      num_matches: 1
    }
  }
}
