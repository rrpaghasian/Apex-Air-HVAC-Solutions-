  file_change {
    absolute_path_uri: "file:///src/components/BottomBookingSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { MapPin, Phone, Mail, Clock, Calendar, CheckCircle2, ShieldCheck, Tag, Send, AlertCircle, CreditCard } from \'lucide-react\';\nimport { COMPANY_INFO } from \'../data/hvacData\';\nimport { BookingFormData } from \'../types\';\nimport confetti from \'canvas-confetti\';\n\ninterface BottomBookingSectionProps {\n  initialPromoCode?: string;\n  initialServiceType?: string;\n  initialNotes?: string;\n  onBookingSuccess: (bookingData: BookingFormData) => void;\n}\n\nexport const BottomBookingSection: React.FC<BottomBookingSectionProps> = ({\n  initialPromoCode = \'SUMMER50\',\n  initialServiceType = \'repair\',\n  initialNotes = \'\',\n  onBookingSuccess,\n}) => {\n  const [formData, setFormData] = useState<BookingFormData>({\n    fullName: \'\',\n    phone: \'\',\n    email: \'\',\n    serviceType: initialServiceType,\n    promoCode: initialPromoCode,\n    notes: initialNotes,\n    preferredDate: \'\',\n    preferredTime: \'morning\',\n  });\n\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n\n  // Synchronize when parent passes updated initial values from coupon clicks or troubleshooter\n  useEffect(() => {\n    setFormData((prev) => ({\n      ...prev,\n      promoCode: initialPromoCode || prev.promoCode,\n      serviceType: initialServiceType || prev.serviceType,\n      notes: initialNotes ? `${prev.notes ? prev.notes + \' | \' : \'\'}${initialNotes}` : prev.notes,\n    }));\n  }, [initialPromoCode, initialServiceType, initialNotes]);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMsg(null);\n\n    if (!formData.fullName.trim()) {\n      setErrorMsg(\'Please enter your full name.\');\n      return;\n    }\n    if (!formData.phone.trim()) {\n      setErrorMsg(\'Please enter a valid phone number for dispatch confirmation.\');\n      return;\n    }\n\n    setIsSubmitting(true);\n\n    setTimeout(() => {\n      setIsSubmitting(false);\n      try {\n        confetti({\n          particleCount: 80,\n          spread: 70,\n          origin: { y: 0.6 },\n        });\n      } catch (err) {\n        // Fallback gracefully\n      }\n      onBookingSuccess(formData);\n    }, 600);\n  };\n\n  return (\n    <section id=\"bottom-booking-section\" className=\"py-16 sm:py-20 bg-slate-900 text-white relative overflow-hidden\">\n      {/* Background ambient accents */}\n      <div className=\"absolute top-0 right-0 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none\" />\n      <div className=\"absolute bottom-0 left-0 w-96 h-96 bg-orange-500/10 rounded-full blur-3xl pointer-events-none\" />\n\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n        \n        {/* Main 3-Column / Grid layout matching the bottom of reference image */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          \n          {/* Left Column: Company Location & Phone Info */}\n          <div className=\"lg:col-span-3 space-y-6\">\n            <div>\n              <div className=\"flex items-center gap-2 mb-2\">\n                <div className=\"w-8 h-8 rounded-lg bg-cyan-600 flex items-center justify-center text-white font-bold text-base\">\n                  \342\235\204\n                </div>\n                <span className=\"text-xl font-black tracking-tight text-white\">\n                  APEX<span className=\"text-cyan-400\">AIR</span>\n                </span>\n              </div>\n              <p className=\"text-xs text-orange-400 font-bold uppercase tracking-wider\">\n                {COMPANY_INFO.brandSubtitle}\n              </p>\n            </div>\n\n            <div className=\"space-y-4 text-xs sm:text-sm text-slate-300\">\n              <div className=\"flex items-start gap-2.5\">\n                <MapPin className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block\">{COMPANY_INFO.location}</strong>\n                  <span>{COMPANY_INFO.address}</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-2.5\">\n                <Phone className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block\">Direct Dispatch</strong>\n                  <a href={`tel:${COMPANY_INFO.phoneRaw}`} className=\"hover:text-cyan-300 font-bold text-white transition-colors\">\n                    {COMPANY_INFO.phone}\n                  </a>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-2.5\">\n                <Mail className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block\">Email Support</strong>\n                  <span>{COMPANY_INFO.email}</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-2.5\">\n                <Clock className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block\">Emergency Coverage</strong>\n                  <span>24 Hours / 7 Days a Week</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"p-3.5 bg-slate-800/80 rounded-xl border border-slate-700 text-xs text-slate-300 space-y-1\">\n              <div className=\"flex items-center gap-1.5 text-emerald-400 font-bold\">\n                <ShieldCheck className=\"w-4 h-4\" />\n                <span>{COMPANY_INFO.license}</span>\n              </div>\n              <p className=\"text-[11px] text-slate-400\">EPA Universal Section 608 Verified Contractor</p>\n            </div>\n          </div>\n\n          {/* Center Column: Form Card \"Schedule Service or Request an Estimate\" matching photo */}\n          <div className=\"lg:col-span-6 bg-white text-slate-900 rounded-2xl p-6 sm:p-8 shadow-2xl border border-slate-200\">\n            <div className=\"mb-6\">\n              <h3 className=\"text-2xl font-black text-slate-900 tracking-tight\">\n                Schedule Service or Request an Estimate\n              </h3>\n              <p className=\"text-xs sm:text-sm text-slate-500 mt-1\">\n                Fill out the quick form below to lock in your discount and get a confirmed dispatch time.\n              </p>\n            </div>\n\n            {errorMsg && (\n              <div className=\"mb-4 p-3 bg-red-50 border border-red-200 text-red-700 text-xs font-semibold rounded-lg flex items-center gap-2\">\n                <AlertCircle className=\"w-4 h-4 shrink-0\" />\n                <span>{errorMsg}</span>\n              </div>\n            )}\n\n            <form onSubmit={handleSubmit} className=\"space-y-4\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                    Your Name *\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    placeholder=\"e.g. John Doe\"\n                    value={formData.fullName}\n                    onChange={(e) => setFormData({ ...formData, fullName: e.target.value })}\n                    className=\"w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:outline-none focus:border-cyan-600 transition-colors\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                    Email Address *\n                  </label>\n                  <input\n                    type=\"email\"\n                    required\n                    placeholder=\"john@example.com\"\n                    value={formData.email}\n                    onChange={(e) => setFormData({ ...formData, email: e.target.value })}\n                    className=\"w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:outline-none focus:border-cyan-600 transition-colors\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                    Phone Number *\n                  </label>\n                  <input\n                    type=\"tel\"\n                    required\n                    placeholder=\"(555) 000-0000\"\n                    value={formData.phone}\n                    onChange={(e) => setFormData({ ...formData, phone: e.target.value })}\n                    className=\"w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:outline-none focus:border-cyan-600 transition-colors\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                    Interest / Service Needed\n                  </label>\n                  <select\n                    value={formData.serviceType}\n                    onChange={(e) => setFormData({ ...formData, serviceType: e.target.value })}\n                    aria-label=\"Service Needed\"\n                    className=\"w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:outline-none focus:border-cyan-600 transition-colors cursor-pointer\"\n                  >\n                    <option value=\"repair\">Emergency AC / Furnace Repair ($79)</option>\n                    <option value=\"tuneup\">21-Point Seasonal Tune-Up ($99)</option>\n                    <option value=\"install\">New System Replacement Estimate (Free)</option>\n                    <option value=\"maintenance\">Comfort Club Membership ($19/mo)</option>\n                    <option value=\"iaq\">Air Quality &amp; Duct Sealing</option>\n                  </select>\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                    Promo Code Applied\n                  </label>\n                  <div className=\"relative\">\n                    <input\n                      type=\"text\"\n                      value={formData.promoCode}\n                      onChange={(e) => setFormData({ ...formData, promoCode: e.target.value.toUpperCase() })}\n                      placeholder=\"e.g. SUMMER50\"\n                      className=\"w-full px-3.5 py-2.5 bg-amber-50/70 border border-amber-300 font-mono font-bold text-slate-800 rounded-lg text-sm focus:outline-none focus:border-cyan-600\"\n                    />\n                    <Tag className=\"w-4 h-4 text-amber-600 absolute right-3 top-3 pointer-events-none\" />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                    Preferred Time Window\n                  </label>\n                  <select\n                    value={formData.preferredTime}\n                    onChange={(e) => setFormData({ ...formData, preferredTime: e.target.value })}\n                    aria-label=\"Preferred Time Window\"\n                    className=\"w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:outline-none focus:border-cyan-600 transition-colors cursor-pointer\"\n                  >\n                    <option value=\"asap\">Immediate / ASAP Emergency</option>\n                    <option value=\"morning\">Morning (8:00 AM - 12:00 PM)</option>\n                    <option value=\"afternoon\">Afternoon (12:00 PM - 4:00 PM)</option>\n                    <option value=\"evening\">Evening (4:00 PM - 8:00 PM)</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Comments / Describe Issues\n                </label>\n                <textarea\n                  rows={2}\n                  placeholder=\"e.g. AC is blowing room temperature air since this morning...\"\n                  value={formData.notes}\n                  onChange={(e) => setFormData({ ...formData, notes: e.target.value })}\n                  className=\"w-full px-3.5 py-2 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:outline-none focus:border-cyan-600 transition-colors\"\n                />\n              </div>\n\n              <button\n                id=\"btn-submit-booking\"\n                type=\"submit\"\n                disabled={isSubmitting}\n                className=\"w-full bg-orange-500 hover:bg-orange-600 active:scale-98 text-white font-black py-3.5 px-6 rounded-xl shadow-lg shadow-orange-500/25 transition-all text-sm uppercase tracking-wider cursor-pointer flex items-center justify-center gap-2\"\n              >\n                {isSubmitting ? (\n                  <span>Reserving Dispatch Window...</span>\n                ) : (\n                  <>\n                    <Send className=\"w-4 h-4\" />\n                    <span>SUBMIT REQUEST &amp; REDEEM VOUCHER</span>\n                  </>\n                )}\n              </button>\n\n              <div className=\"flex items-center justify-between text-[11px] text-slate-500 pt-1\">\n                <span className=\"flex items-center gap-1\">\n                  \360\237\224\222 <span>Zero payment required until work is completed</span>\n                </span>\n                <span>SMS confirmation sent instantly</span>\n              </div>\n            </form>\n          </div>\n\n          {/* Right Column: Service Van Graphic + Payment Badges matching reference photo */}\n          <div className=\"lg:col-span-3 flex flex-col items-center lg:items-end justify-between space-y-6\">\n            \n            {/* Realistic Service Van Card matching the van in the photo */}\n            <div className=\"bg-gradient-to-br from-slate-800 to-slate-850 p-4 rounded-2xl border border-slate-700 shadow-xl text-center w-full max-w-sm\">\n              <div className=\"relative rounded-xl overflow-hidden mb-3 bg-slate-900 border border-slate-700\">\n                <img\n                  src=\"https://images.unsplash.com/photo-1541888946425-d0fbb18086f6?auto=format&fit=crop&w=600&q=80\"\n                  alt=\"Apex Air Fleet Service Van\"\n                  className=\"w-full h-36 object-cover\"\n                />\n                <div className=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent flex items-end p-2.5\">\n                  <span className=\"text-[11px] font-bold text-white bg-orange-500/90 px-2 py-0.5 rounded\">\n                    Mobile Parts Warehouse\n                  </span>\n                </div>\n              </div>\n              <h4 className=\"text-sm font-bold text-white\">Stocked Fleet Trucks</h4>\n              <p className=\"text-[11px] text-slate-400 mt-1 leading-snug\">\n                Every vehicle carries universal capacitors, fan motors, contactors, and digital refrigerant gauges.\n              </p>\n            </div>\n\n            {/* \"We Accept :)\" Payment Badges matching reference photo */}\n            <div className=\"text-center lg:text-right w-full\">\n              <p className=\"text-xs font-bold text-slate-300 mb-2 flex items-center justify-center lg:justify-end gap-1.5\">\n                <span>We Accept :)</span>\n              </p>\n              <div className=\"flex flex-wrap items-center justify-center lg:justify-end gap-1.5\">\n                <span className=\"bg-slate-800 text-orange-400 font-extrabold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-slate-700\">\n                  DISCOVER\n                </span>\n                <span className=\"bg-slate-800 text-blue-400 font-extrabold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-slate-700\">\n                  AMEX\n                </span>\n                <span className=\"bg-slate-800 text-cyan-400 font-extrabold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-slate-700\">\n                  VISA\n                </span>\n                <span className=\"bg-slate-800 text-red-400 font-extrabold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-slate-700\">\n                  MasterCard\n                </span>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n  );\n};\n"
    }
