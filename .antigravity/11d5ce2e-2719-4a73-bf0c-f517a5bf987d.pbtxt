  file_change {
    absolute_path_uri: "file:///src/components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { Phone, Calendar, Menu, X, Flame, Snowflake, Shield, Sparkles, ChevronDown } from \'lucide-react\';\nimport { COMPANY_INFO } from \'../data/hvacData\';\n\ninterface NavbarProps {\n  onBookClick: (promoCode?: string, serviceType?: string) => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ onBookClick }) => {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const [isScrolled, setIsScrolled] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setIsScrolled(window.scrollY > 20);\n    };\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const scrollToSection = (id: string) => {\n    setMobileMenuOpen(false);\n    const element = document.getElementById(id);\n    if (element) {\n      const yOffset = -80;\n      const y = element.getBoundingClientRect().top + window.pageYOffset + yOffset;\n      window.scrollTo({ top: y, behavior: \'smooth\' });\n    }\n  };\n\n  return (\n    <header\n      id=\"main-header\"\n      className={`sticky top-0 z-40 bg-white transition-shadow duration-200 ${\n        isScrolled ? \'shadow-md border-b border-slate-200\' : \'border-b border-slate-100\'\n      }`}\n    >\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <nav className=\"flex items-center justify-between h-20\">\n          {/* Brand Logo matching the photo: A/C Solutions style logo with snowflakes & flame */}\n          <a\n            href=\"#\"\n            onClick={(e) => {\n              e.preventDefault();\n              window.scrollTo({ top: 0, behavior: \'smooth\' });\n            }}\n            className=\"flex items-center gap-2 text-decoration-none group\"\n            id=\"brand-logo-link\"\n          >\n            <div className=\"flex items-center justify-center w-11 h-11 rounded-lg bg-gradient-to-br from-cyan-500 to-blue-700 text-white shadow-md shadow-cyan-500/20 group-hover:scale-105 transition-transform\">\n              <div className=\"relative\">\n                <Snowflake className=\"w-6 h-6 text-white\" />\n                <Flame className=\"w-3.5 h-3.5 text-amber-300 absolute -bottom-1 -right-1 fill-amber-400\" />\n              </div>\n            </div>\n            <div>\n              <div className=\"flex items-baseline\">\n                <span className=\"text-2xl font-black tracking-tight text-slate-900\">\n                  APEX<span className=\"text-cyan-600\">AIR</span>\n                </span>\n              </div>\n              <p className=\"text-[10px] uppercase font-bold tracking-wider text-orange-600 -mt-1\">\n                Heating &amp; Air Solutions\n              </p>\n            </div>\n          </a>\n\n          {/* Desktop Nav Links matching reference photo */}\n          <div className=\"hidden lg:flex items-center space-x-6 text-sm font-semibold text-slate-700\">\n            <button\n              onClick={() => window.scrollTo({ top: 0, behavior: \'smooth\' })}\n              className=\"hover:text-cyan-600 transition-colors cursor-pointer py-1\"\n            >\n              Home\n            </button>\n            <button\n              onClick={() => scrollToSection(\'services-section\')}\n              className=\"hover:text-cyan-600 transition-colors cursor-pointer py-1\"\n            >\n              Our Services\n            </button>\n            <button\n              onClick={() => scrollToSection(\'troubleshooting-widget\')}\n              className=\"hover:text-cyan-600 transition-colors cursor-pointer py-1 flex items-center gap-1\"\n            >\n              <span>Diagnostics</span>\n              <span className=\"bg-orange-100 text-orange-700 text-[10px] font-bold px-1.5 py-0.5 rounded\">Quiz</span>\n            </button>\n            <button\n              onClick={() => scrollToSection(\'seer-calculator-widget\')}\n              className=\"hover:text-cyan-600 transition-colors cursor-pointer py-1 flex items-center gap-1\"\n            >\n              <span>SEER Savings</span>\n              <span className=\"bg-emerald-100 text-emerald-700 text-[10px] font-bold px-1.5 py-0.5 rounded\">ROI</span>\n            </button>\n            <button\n              onClick={() => scrollToSection(\'maintenance-section\')}\n              className=\"hover:text-cyan-600 transition-colors cursor-pointer py-1\"\n            >\n              Maintenance\n            </button>\n            <button\n              onClick={() => scrollToSection(\'coupons-section\')}\n              className=\"hover:text-cyan-600 transition-colors cursor-pointer py-1 text-orange-600 font-bold\"\n            >\n              Special &amp; Rebates\n            </button>\n            <button\n              onClick={() => scrollToSection(\'reviews-section\')}\n              className=\"hover:text-cyan-600 transition-colors cursor-pointer py-1\"\n            >\n              Testimonials\n            </button>\n          </div>\n\n          {/* Right CTAs: Phone number + Book button */}\n          <div className=\"hidden sm:flex items-center gap-4\">\n            <a\n              href={`tel:${COMPANY_INFO.phoneRaw}`}\n              id=\"header-phone-cta\"\n              className=\"flex flex-col text-right group\"\n            >\n              <span className=\"text-[11px] text-slate-500 font-semibold uppercase tracking-wider\">\n                Speak to a Technician\n              </span>\n              <span className=\"text-lg font-black text-slate-900 group-hover:text-cyan-600 transition-colors flex items-center gap-1.5\">\n                <Phone className=\"w-4 h-4 text-orange-500 fill-orange-500/20\" />\n                {COMPANY_INFO.phone}\n              </span>\n            </a>\n\n            <button\n              id=\"header-book-btn\"\n              onClick={() => onBookClick(\'REBATE25\', \'repair\')}\n              className=\"bg-orange-500 hover:bg-orange-600 active:scale-95 text-white font-bold px-5 py-2.5 rounded-lg shadow-md shadow-orange-500/20 hover:shadow-lg transition-all flex items-center gap-2 cursor-pointer text-sm\"\n            >\n              <Calendar className=\"w-4 h-4\" />\n              <span>Book Online</span>\n            </button>\n          </div>\n\n          {/* Mobile Menu Toggle Button */}\n          <div className=\"flex items-center sm:hidden gap-2\">\n            <a\n              href={`tel:${COMPANY_INFO.phoneRaw}`}\n              className=\"p-2 text-orange-600 bg-orange-50 rounded-lg\"\n              title=\"Call Us Now\"\n            >\n              <Phone className=\"w-5 h-5\" />\n            </a>\n            <button\n              id=\"mobile-menu-toggle\"\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              aria-label=\"Toggle Navigation Menu\"\n              className=\"p-2 rounded-lg text-slate-700 hover:bg-slate-100 focus:outline-none\"\n            >\n              {mobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n            </button>\n          </div>\n        </nav>\n      </div>\n\n      {/* Mobile Drawer Menu */}\n      {mobileMenuOpen && (\n        <div id=\"mobile-menu-drawer\" className=\"lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-3 shadow-xl\">\n          <div className=\"grid grid-cols-2 gap-2 text-sm font-semibold text-slate-700\">\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                window.scrollTo({ top: 0, behavior: \'smooth\' });\n              }}\n              className=\"p-2.5 text-left rounded-lg bg-slate-50 hover:bg-slate-100\"\n            >\n              Home\n            </button>\n            <button\n              onClick={() => scrollToSection(\'services-section\')}\n              className=\"p-2.5 text-left rounded-lg bg-slate-50 hover:bg-slate-100\"\n            >\n              Our Services\n            </button>\n            <button\n              onClick={() => scrollToSection(\'troubleshooting-widget\')}\n              className=\"p-2.5 text-left rounded-lg bg-slate-50 hover:bg-slate-100 text-orange-600 font-bold\"\n            >\n              Troubleshooter Quiz\n            </button>\n            <button\n              onClick={() => scrollToSection(\'seer-calculator-widget\')}\n              className=\"p-2.5 text-left rounded-lg bg-slate-50 hover:bg-slate-100 text-emerald-700 font-bold\"\n            >\n              SEER Calculator\n            </button>\n            <button\n              onClick={() => scrollToSection(\'maintenance-section\')}\n              className=\"p-2.5 text-left rounded-lg bg-slate-50 hover:bg-slate-100\"\n            >\n              Maintenance Plan\n            </button>\n            <button\n              onClick={() => scrollToSection(\'coupons-section\')}\n              className=\"p-2.5 text-left rounded-lg bg-slate-50 hover:bg-slate-100 text-orange-600\"\n            >\n              Coupons &amp; Deals\n            </button>\n            <button\n              onClick={() => scrollToSection(\'reviews-section\')}\n              className=\"p-2.5 text-left rounded-lg bg-slate-50 hover:bg-slate-100\"\n            >\n              Client Reviews\n            </button>\n            <button\n              onClick={() => scrollToSection(\'bottom-booking-section\')}\n              className=\"p-2.5 text-left rounded-lg bg-slate-50 hover:bg-slate-100 text-cyan-700\"\n            >\n              Request Estimate\n            </button>\n          </div>\n\n          <div className=\"pt-2 border-t border-slate-100 flex flex-col gap-2\">\n            <a\n              href={`tel:${COMPANY_INFO.phoneRaw}`}\n              className=\"w-full py-3 bg-slate-900 text-white rounded-lg text-center font-bold text-sm flex items-center justify-center gap-2\"\n            >\n              <Phone className=\"w-4 h-4 text-orange-400\" />\n              Call Now: {COMPANY_INFO.phone}\n            </a>\n            <button\n              onClick={() => {\n                setMobileMenuOpen(false);\n                onBookClick(\'SUMMER50\', \'repair\');\n              }}\n              className=\"w-full py-3 bg-orange-500 hover:bg-orange-600 text-white rounded-lg text-center font-bold text-sm flex items-center justify-center gap-2 shadow-md shadow-orange-500/20\"\n            >\n              <Calendar className=\"w-4 h-4\" />\n              Book Service Window Online\n            </button>\n          </div>\n        </div>\n      )}\n    </header>\n  );\n};\n"
    }
    diff {
      unified_diff {
