  AC &amp; Heating Services\n                </a>\n              </li>\n              <li>\n                <a href=\"#troubleshooting-widget\" className=\"hover:text-cyan-400 transition-colors\">\n                  HVAC Diagnostics Wizard\n                </a>\n              </li>\n              <li>\n                <a href=\"#seer-calculator-widget\" className=\"hover:text-cyan-400 transition-colors\">\n                  SEER Energy Savings Auditor\n                </a>\n              </li>\n              <li>\n                <a href=\"#maintenance-section\" className=\"hover:text-cyan-400 transition-colors\">\n                  Comfort Club Maintenance Plan\n                </a>\n              </li>\n              <li>\n                <a href=\"#coupons-section\" className=\"hover:text-cyan-400 transition-colors\">\n                  Seasonal Rebates &amp; Coupons\n                </a>\n              </li>\n              <li>\n                <a href=\"#pricing-section\" className=\"hover:text-cyan-400 transition-colors\">\n                  Transparent Pricing\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          {/* Service Areas */}\n          <div className=\"space-y-2.5\">\n            <h4 className=\"text-xs font-bold uppercase tracking-wider text-white\">\n              Service Areas\n            </h4>\n            <p className=\"text-xs text-slate-400 leading-relaxed\">\n              Buford, Flowery Branch, Gainesville, Sugar Hill, Suwanee, Cumming, Braselton, Oakwood, and Hall/Gwinnett counties.\n            </p>\n            <div className=\"pt-2\">\n              <button\n                type=\"button\"\n                onClick={onOpenGHLModal}\n                className=\"inline-flex items-center gap-1.5 bg-slate-800 hover:bg-slate-700 text-cyan-400 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer\"\n              >\n                <Code className=\"w-3.5 h-3.5\" />\n                <span>Export GoHighLevel HTML</span>\n              </button>\n            </div>\n          </div>\n\n        </div>\n\n        {/* Bottom Bar */}\n        <div className=\"pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500\">\n          <p>&copy; 2026 {COMPANY_INFO.name}. All rights reserved.</p>\n          <div className=\"flex items-center gap-6\">\n            <a href=\"#\" className=\"hover:text-slate-400 transition-colors\">Privacy Policy</a>\n            <a href=\"#\" className=\"hover:text-slate-400 transition-colors\">Terms of Service</a>\n            <a href=\"#\" className=\"hover:text-slate-400 transition-colors\">Sitemap</a>\n          </div>\n        </div>\n\n      </div>\n    </footer>\n  );\n};"
      replacement_content: "import React from \'react\';\nimport { ShieldCheck, Phone, Mail, MapPin, Clock, Code, Truck } from \'lucide-react\';\nimport { COMPANY_INFO } from \'../data/hvacData\';\n\ninterface FooterProps {\n  onOpenGHLModal: () => void;\n}\n\nexport const Footer: React.FC<FooterProps> = ({ onOpenGHLModal }) => {\n  return (\n    <footer id=\"main-footer\" className=\"bg-slate-950 text-slate-400 text-xs sm:text-sm border-t border-slate-800\">\n      \n      {/* Top Footer Section: Company Info + Stocked Fleet Trucks & Payment Methods */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-10 border-b border-slate-800/80\">\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 items-start\">\n          \n          {/* Left Column: Company Location & Direct Dispatch Info (from Screenshot 1) */}\n          <div className=\"lg:col-span-5 space-y-6\">\n            <div>\n              <div className=\"flex items-center gap-2 mb-2\">\n                <div className=\"w-8 h-8 rounded-lg bg-cyan-600 flex items-center justify-center text-white font-bold text-base shadow-md\">\n                  \342\235\204\n                </div>\n                <span className=\"text-2xl font-black tracking-tight text-white\">\n                  APEX<span className=\"text-cyan-400\">AIR</span>\n                </span>\n              </div>\n              <p className=\"text-xs text-orange-400 font-extrabold uppercase tracking-wider\">\n                {COMPANY_INFO.brandSubtitle}\n              </p>\n            </div>\n\n            <div className=\"space-y-4 text-xs sm:text-sm text-slate-300\">\n              <div className=\"flex items-start gap-3\">\n                <MapPin className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block font-bold\">{COMPANY_INFO.location}</strong>\n                  <span className=\"text-slate-400\">{COMPANY_INFO.address}</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-3\">\n                <Phone className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block font-bold\">Direct Dispatch</strong>\n                  <a href={`tel:${COMPANY_INFO.phoneRaw}`} className=\"hover:text-cyan-300 font-bold text-white transition-colors text-base\">\n                    {COMPANY_INFO.phone}\n                  </a>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-3\">\n                <Mail className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block font-bold\">Email Support</strong>\n                  <span className=\"text-slate-400\">{COMPANY_INFO.email}</span>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-3\">\n                <Clock className=\"w-4 h-4 text-orange-400 shrink-0 mt-0.5\" />\n                <div>\n                  <strong className=\"text-white block font-bold\">Emergency Coverage</strong>\n                  <span className=\"text-slate-400\">24 Hours / 7 Days a Week</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"p-3.5 bg-slate-900/90 rounded-xl border border-slate-800 text-xs text-slate-300 space-y-1\">\n              <div className=\"flex items-center gap-2 text-emerald-400 font-bold\">\n                <ShieldCheck className=\"w-4 h-4\" />\n                <span>{COMPANY_INFO.license}</span>\n              </div>\n              <p className=\"text-[11px] text-slate-400\">EPA Universal Section 608 Verified Contractor</p>\n            </div>\n          </div>\n\n          {/* Middle Column: Quick Links & Service Areas */}\n          <div className=\"lg:col-span-3 space-y-4\">\n            <h4 className=\"text-xs font-bold uppercase tracking-wider text-white\">\n              Quick Navigation\n            </h4>\n            <ul className=\"space-y-2 text-xs text-slate-400\">\n              <li>\n                <a href=\"#services-section\" className=\"hover:text-cyan-400 transition-colors\">\n                  AC &amp; Heating Services\n                </a>\n              </li>\n              <li>\n                <a href=\"#troubleshooting-widget\" className=\"hover:text-cyan-400 transition-colors\">\n                  HVAC Diagnostics Wizard\n                </a>\n              </li>\n              <li>\n                <a href=\"#seer-calculator-widget\" className=\"hover:text-cyan-400 transition-colors\">\n                  SEER Energy Savings Auditor\n                </a>\n              </li>\n              <li>\n                <a href=\"#maintenance-section\" className=\"hover:text-cyan-400 transition-colors\">\n                  Comfort Club Maintenance Plan\n                </a>\n              </li>\n              <li>\n                <a href=\"#coupons-section\" className=\"hover:text-cyan-400 transition-colors\">\n                  Seasonal Rebates &amp; Coupons\n                </a>\n              </li>\n              <li>\n                <a href=\"#bottom-booking-section\" className=\"hover:text-orange-400 font-bold text-slate-300 transition-colors\">\n                  \360\237\223\205 Schedule Service ($25 OFF)\n                </a>\n              </li>\n            </ul>\n\n            <div className=\"pt-2\">\n              <button\n                type=\"button\"\n                onClick={onOpenGHLModal}\n                className=\"inline-flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800 text-cyan-400 border border-slate-700 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer shadow-sm\"\n              >\n                <Code className=\"w-3.5 h-3.5\" />\n                <span>Export GoHighLevel HTML</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Right Column: Stocked Fleet Truck Card + Payment Badges (from Screenshot 2) */}\n          <div className=\"lg:col-span-4 flex flex-col items-center lg:items-end justify-between space-y-6\">\n            \n            {/* Realistic Service Van Card */}\n            <div className=\"bg-gradient-to-br from-slate-900 to-slate-850 p-4 rounded-2xl border border-slate-800 shadow-xl text-center w-full max-w-sm\">\n              <div className=\"relative rounded-xl overflow-hidden mb-3 bg-slate-900 border border-slate-800\">\n                <img\n                  src=\"https://images.unsplash.com/photo-1541888946425-d0fbb18086f6?auto=format&fit=crop&w=600&q=80\"\n                  alt=\"Apex Air Fleet Service Van\"\n                  className=\"w-full h-36 object-cover\"\n                />\n                <div className=\"absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent flex items-end p-2.5\">\n                  <span className=\"text-[11px] font-bold text-white bg-orange-500/90 px-2 py-0.5 rounded\">\n                    Mobile Parts Warehouse\n                  </span>\n                </div>\n              </div>\n              <h4 className=\"text-sm font-bold text-white flex items-center justify-center gap-1.5\">\n                <Truck className=\"w-4 h-4 text-cyan-400\" />\n                <span>Stocked Fleet Trucks</span>\n              </h4>\n              <p className=\"text-[11px] text-slate-400 mt-1 leading-snug\">\n                Every vehicle carries universal capacitors, fan motors, contactors, and digital refrigerant gauges.\n              </p>\n            </div>\n\n            {/* \"We Accept :)\" Payment Badges */}\n            <div className=\"text-center lg:text-right w-full\">\n              <p className=\"text-xs font-bold text-slate-300 mb-2 flex items-center justify-center lg:justify-end gap-1.5\">\n                <span>We Accept :)</span>\n              </p>\n              <div className=\"flex flex-wrap items-center justify-center lg:justify-end gap-1.5\">\n                <span className=\"bg-slate-900 text-orange-400 font-extrabold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-slate-800 shadow-inner\">\n                  DISCOVER\n                </span>\n                <span className=\"bg-slate-900 text-blue-400 font-extrabold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-slate-800 shadow-inner\">\n                  AMEX\n                </span>\n                <span className=\"bg-slate-900 text-cyan-400 font-extrabold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-slate-800 shadow-inner\">\n                  VISA\n                </span>\n                <span className=\"bg-slate-900 text-red-400 font-extrabold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded border border-slate-800 shadow-inner\">\n                  MASTERCARD\n                </span>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n      </div>\n\n      {/* Bottom Legal Copyright Bar */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500\">\n        <p>&copy; 2026 {COMPANY_INFO.name}. All rights reserved. Licensed, Bonded &amp; Insured HVAC Contractors.</p>\n        <div className=\"flex items-center gap-6\">\n          <a href=\"#\" className=\"hover:text-slate-400 transition-colors\">Privacy Policy</a>\n          <a href=\"#\" className=\"hover:text-slate-400 transition-colors\">Terms of Service</a>\n          <a href=\"#\" className=\"hover:text-slate-400 transition-colors\">Sitemap</a>\n        </div>\n      </div>\n\n    </footer>\n  );\n};\n"
    }
