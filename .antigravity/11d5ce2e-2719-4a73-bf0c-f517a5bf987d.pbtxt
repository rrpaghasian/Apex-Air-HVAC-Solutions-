        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    function setIssue(type) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const box = document.getElementById(\'ghl-symptom-box\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (type === \'ac\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        box.innerHTML = \'<strong>Common AC Diagnosis:</strong> Low refrigerant charge or failed capacitor. Recommended: Immediate $79 diagnostic call.\';"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        box.innerHTML = \'<strong>Common AC Diagnosis:</strong> Low refrigerant charge or failed start capacitor. Recommended: Immediate $79 diagnostic dispatch.\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      } else {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        box.innerHTML = \'<strong>Common Heating Diagnosis:</strong> Dirty flame sensor or cracked hot surface ignitor. Recommended: Safety combustion check.\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
