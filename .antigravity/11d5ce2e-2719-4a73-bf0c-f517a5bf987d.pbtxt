  file_change {
    absolute_path_uri: "file:///src/components/ReviewModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Star, ThumbsUp, Send, CheckCircle2, MessageSquare } from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\n\ninterface ReviewModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const ReviewModal: React.FC<ReviewModalProps> = ({ isOpen, onClose }) => {\n  const [rating, setRating] = useState(5);\n  const [hoverRating, setHoverRating] = useState(0);\n  const [name, setName] = useState(\'\');\n  const [technicianName, setTechnicianName] = useState(\'\');\n  const [reviewText, setReviewText] = useState(\'\');\n  const [submitted, setSubmitted] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setSubmitted(true);\n    try {\n      confetti({\n        particleCount: 70,\n        spread: 60,\n        origin: { y: 0.6 },\n      });\n    } catch (err) {\n      // fallback\n    }\n  };\n\n  const handleReset = () => {\n    setSubmitted(false);\n    setName(\'\');\n    setTechnicianName(\'\');\n    setReviewText(\'\');\n    setRating(5);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-xs\">\n      <div\n        className=\"relative bg-white text-slate-900 rounded-2xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-200 animate-in fade-in zoom-in-95 duration-200\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        <button\n          type=\"button\"\n          onClick={onClose}\n          aria-label=\"Close review modal\"\n          className=\"absolute top-4 right-4 text-slate-400 hover:text-slate-700 transition-colors cursor-pointer\"\n        >\n          <X className=\"w-6 h-6\" />\n        </button>\n\n        {!submitted ? (\n          <div>\n            <div className=\"flex items-center gap-3 mb-4\">\n              <div className=\"w-10 h-10 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center\">\n                <ThumbsUp className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <h3 className=\"text-xl font-black text-slate-900\">Rate Our HVAC Tech</h3>\n                <p className=\"text-xs text-slate-500\">Your feedback helps us maintain our 4.9-star service standard.</p>\n              </div>\n            </div>\n\n            <form onSubmit={handleSubmit} className=\"space-y-4\">\n              {/* Star Rating selector */}\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1.5 text-center\">\n                  Overall Service Rating\n                </label>\n                <div className=\"flex items-center justify-center gap-2 py-1\">\n                  {[1, 2, 3, 4, 5].map((star) => (\n                    <button\n                      key={star}\n                      type=\"button\"\n                      onClick={() => setRating(star)}\n                      onMouseEnter={() => setHoverRating(star)}\n                      onMouseLeave={() => setHoverRating(0)}\n                      className=\"p-1 text-amber-400 hover:scale-125 transition-transform cursor-pointer\"\n                    >\n                      <Star\n                        className={`w-8 h-8 ${\n                          (hoverRating || rating) >= star\n                            ? \'fill-amber-400 text-amber-400\'\n                            : \'text-slate-300\'\n                        }`}\n                      />\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Your Full Name *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"e.g. Sarah Jenkins\"\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  className=\"w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:outline-none focus:border-cyan-600\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Technician Name (Optional)\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. Mike / Carlos\"\n                  value={technicianName}\n                  onChange={(e) => setTechnicianName(e.target.value)}\n                  className=\"w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:outline-none focus:border-cyan-600\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-bold text-slate-700 mb-1\">\n                  Your Review &amp; Comments *\n                </label>\n                <textarea\n                  required\n                  rows={3}\n                  placeholder=\"Tell us about the punctuality, cleanliness, repair quality, and overall experience...\"\n                  value={reviewText}\n                  onChange={(e) => setReviewText(e.target.value)}\n                  className=\"w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-sm focus:bg-white focus:outline-none focus:border-cyan-600\"\n                />\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"w-full bg-orange-500 hover:bg-orange-600 active:scale-98 text-white font-black py-3.5 px-4 rounded-xl shadow-md transition-all text-sm uppercase tracking-wider cursor-pointer flex items-center justify-center gap-2\"\n              >\n                <Send className=\"w-4 h-4\" />\n                <span>Submit Verified Feedback</span>\n              </button>\n            </form>\n          </div>\n        ) : (\n          <div className=\"text-center py-6 space-y-4\">\n            <div className=\"w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto\">\n              <CheckCircle2 className=\"w-10 h-10\" />\n            </div>\n            <h3 className=\"text-2xl font-black text-slate-900\">Thank You, {name}!</h3>\n            <p className=\"text-sm text-slate-600 max-w-sm mx-auto\">\n              Your {rating}-star review has been recorded. Our team and field technicians deeply appreciate your feedback and trust in Apex Air Solutions.\n            </p>\n            <button\n              type=\"button\"\n              onClick={handleReset}\n              className=\"bg-slate-900 hover:bg-slate-800 text-white font-bold px-6 py-2.5 rounded-lg text-sm transition-colors cursor-pointer\"\n            >\n              Done\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
