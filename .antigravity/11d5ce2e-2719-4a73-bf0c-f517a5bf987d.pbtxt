    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { TopBar } from \'./components/TopBar\';\nimport { Navbar } from \'./components/Navbar\';\nimport { HeroSection } from \'./components/HeroSection\';\nimport { InteractiveTroubleshooter } from \'./components/InteractiveTroubleshooter\';\nimport { SeerCalculator } from \'./components/SeerCalculator\';\nimport { ServicesSection } from \'./components/ServicesSection\';\nimport { MaintenanceSection } from \'./components/MaintenanceSection\';\nimport { CertificationsSection } from \'./components/CertificationsSection\';\nimport { ReviewsAndFeedbackSection } from \'./components/ReviewsAndFeedbackSection\';\nimport { CouponsSection } from \'./components/CouponsSection\';\nimport { TransparentPricingSection } from \'./components/TransparentPricingSection\';\nimport { BottomBookingSection } from \'./components/BottomBookingSection\';\nimport { Footer } from \'./components/Footer\';\nimport { ServiceModal } from \'./components/ServiceModal\';\nimport { ReviewModal } from \'./components/ReviewModal\';\nimport { BookingSuccessModal } from \'./components/BookingSuccessModal\';\nimport { GoHighLevelModal } from \'./components/GoHighLevelModal\';\nimport { ServiceItem, BookingFormData } from \'./types\';\nimport { Phone, Calendar, Code, Sparkles } from \'lucide-react\';\nimport { COMPANY_INFO } from \'./data/hvacData\';\n\nexport default function App() {\n  // Application State\n  const [selectedService, setSelectedService] = useState<ServiceItem | null>(null);\n  const [isReviewModalOpen, setIsReviewModalOpen] = useState(false);\n  const [isGHLModalOpen, setIsGHLModalOpen] = useState(false);\n  const [confirmedBooking, setConfirmedBooking] = useState<BookingFormData | null>(null);\n\n  // Form Pre-population State\n  const [currentPromoCode, setCurrentPromoCode] = useState<string>(\'SUMMER50\');\n  const [currentServiceType, setCurrentServiceType] = useState<string>(\'repair\');\n  const [currentNotes, setCurrentNotes] = useState<string>(\'\');\n\n  // Smooth scroll helper\n  const scrollToBooking = () => {\n    const element = document.getElementById(\'bottom-booking-section\');\n    if (element) {\n      const yOffset = -40;\n      const y = element.getBoundingClientRect().top + window.pageYOffset + yOffset;\n      window.scrollTo({ top: y, behavior: \'smooth\' });\n    }\n  };\n\n  const scrollToTroubleshooter = () => {\n    const element = document.getElementById(\'troubleshooting-widget\');\n    if (element) {\n      const yOffset = -100;\n      const y = element.getBoundingClientRect().top + window.pageYOffset + yOffset;\n      window.scrollTo({ top: y, behavior: \'smooth\' });\n    }\n  };\n\n  const scrollToSeer = () => {\n    const element = document.getElementById(\'seer-calculator-widget\');\n    if (element) {\n      const yOffset = -100;\n      const y = element.getBoundingClientRect().top + window.pageYOffset + yOffset;\n      window.scrollTo({ top: y, behavior: \'smooth\' });\n    }\n  };\n\n  // Handlers for interactive triggers\n  const handleBookWithPromo = (promoCode = \'REBATE25\', serviceType = \'repair\') => {\n    setCurrentPromoCode(promoCode);\n    setCurrentServiceType(serviceType);\n    scrollToBooking();\n  };\n\n  const handleApplyCoupon = (promoCode: string, serviceType: string) => {\n    setCurrentPromoCode(promoCode);\n    setCurrentServiceType(serviceType);\n    scrollToBooking();\n  };\n\n  const handleTroubleshooterBook = (promoCode: string, symptom: string) => {\n    setCurrentPromoCode(promoCode);\n    setCurrentServiceType(\'repair\');\n    setCurrentNotes(`Diagnosed via Troubleshooting Wizard: ${symptom}`);\n    scrollToBooking();\n  };\n\n  const handleClaimRebate = (promoCode: string) => {\n    setCurrentPromoCode(promoCode);\n    setCurrentServiceType(\'install\');\n    setCurrentNotes(\'Inquiry for high-efficiency SEER2 replacement & energy rebate ($500 OFF).\');\n    scrollToBooking();\n  };\n\n  const handleSelectPricingTier = (code: string, serviceVal: string) => {\n    setCurrentPromoCode(code);\n    setCurrentServiceType(serviceVal);\n    scrollToBooking();\n  };\n\n  const handleJoinMaintenance = () => {\n    setCurrentPromoCode(\'CLUB19\');\n    setCurrentServiceType(\'maintenance\');\n    setCurrentNotes(\'Comfort Club Annual Maintenance Plan Enrollment ($19/mo).\');\n    scrollToBooking();\n  };\n\n  const handleBookingSuccess = (data: BookingFormData) => {\n    setConfirmedBooking(data);\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-white text-slate-900 selection:bg-cyan-500 selection:text-white font-sans antialiased\">\n      {/* 1. Urgent Top Bar */}\n      <TopBar onOpenGHLModal={() => setIsGHLModalOpen(true)} />\n\n      {/* 2. Main Navigation Header */}\n      <Navbar onBookClick={handleBookWithPromo} />\n\n      <main className=\"flex-1\">\n        {/* 3. Hero Section matching \"Get $25 off on any service call\" */}\n        <HeroSection\n          onScheduleService={() => handleBookWithPromo(\'REBATE25\', \'repair\')}\n          onGetEstimate={scrollToSeer}\n          onOpenTroubleshooter={scrollToTroubleshooter}\n        />\n\n        {/* 4. Dual Interactive Widgets: Troubleshooting Quiz & SEER Energy Calculator matching reference image */}\n        <section className=\"py-12 sm:py-16 bg-slate-100/90 border-b border-slate-200\">\n          <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch\">\n              {/* Left Widget: HVAC Troubleshooting System */}\n              <InteractiveTroubleshooter\n                onBookWithDiagnostic={handleTroubleshooterBook}\n              />\n\n              {/* Right Widget: See How Much You Can Save :) SEER Calculator */}\n              <SeerCalculator\n                onClaimRebate={handleClaimRebate}\n              />\n            </div>\n          </div>\n        </section>\n\n        {/* 5. Our Services Grid / Carousel */}\n        <ServicesSection\n          onSelectService={(service) => setSelectedService(service)}\n          onBookService={(promo, type) => handleBookWithPromo(promo, type)}\n        />\n\n        {/* 6. Maintenance Plan Benefits (12 Checkpoints Matrix) */}\n        <MaintenanceSection onJoinMaintenance={handleJoinMaintenance} />\n\n        {/* 7. Certifications and Associations */}\n        <CertificationsSection />\n\n        {/* 8. Split Social Proof: \"What our clients are saying\" + \"Rate our tech\" */}\n        <ReviewsAndFeedbackSection\n          onOpenReviewModal={() => setIsReviewModalOpen(true)}\n        />\n\n        {/* 9. Seasonal Discounts & Digital Coupons */}\n        <CouponsSection onApplyCoupon={handleApplyCoupon} />\n\n        {/* 10. Transparent Pricing Tiers */}\n        <TransparentPricingSection onSelectTier={handleSelectPricingTier} />\n\n        {/* 11. Schedule Service or Request an Estimate (Bottom Contact Form & Fleet Van Card) */}\n        <BottomBookingSection\n          initialPromoCode={currentPromoCode}\n          initialServiceType={currentServiceType}\n          initialNotes={currentNotes}\n          onBookingSuccess={handleBookingSuccess}\n        />\n      </main>\n\n      {/* 12. Footer */}\n      <Footer onOpenGHLModal={() => setIsGHLModalOpen(true)} />\n\n      {/* Floating Quick Action Widget for Mobile & Fast GHL Code Export */}\n      <div className=\"fixed bottom-4 right-4 z-40 flex flex-col gap-2\">\n        <button\n          onClick={() => setIsGHLModalOpen(true)}\n          className=\"bg-slate-900 hover:bg-slate-850 text-cyan-400 border border-slate-700 hover:border-cyan-400 p-3 rounded-full shadow-2xl transition-all hover:scale-105 cursor-pointer flex items-center justify-center group\"\n          title=\"Export GoHighLevel (GHL) Landing Page HTML Code\"\n        >\n          <Code className=\"w-5 h-5\" />\n          <span className=\"max-w-0 overflow-hidden whitespace-nowrap group-hover:max-w-xs transition-all duration-300 ease-in-out text-xs font-bold text-white px-0 group-hover:px-2\">\n            GoHighLevel HTML\n          </span>\n        </button>\n\n        <button\n          onClick={() => handleBookWithPromo(\'REBATE25\', \'repair\')}\n          className=\"bg-orange-500 hover:bg-orange-600 text-white p-3.5 rounded-full shadow-2xl transition-all hover:scale-105 cursor-pointer flex items-center justify-center\"\n          title=\"Book Service Appointment\"\n        >\n          <Calendar className=\"w-5 h-5\" />\n        </button>\n      </div>\n\n      {/* Modals */}\n      <ServiceModal\n        service={selectedService}\n        onClose={() => setSelectedService(null)}\n        onBook={(serviceId) => handleBookWithPromo(\'REBATE25\', serviceId)}\n      />\n\n      <ReviewModal\n        isOpen={isReviewModalOpen}\n        onClose={() => setIsReviewModalOpen(false)}\n      />\n\n      <BookingSuccessModal\n        bookingData={confirmedBooking}\n        onClose={() => setConfirmedBooking(null)}\n      />\n\n      <GoHighLevelModal\n        isOpen={isGHLModalOpen}\n        onClose={() => setIsGHLModalOpen(false)}\n      />\n    </div>\n  );\n}\n"
    }
