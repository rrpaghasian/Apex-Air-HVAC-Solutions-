      target_content: "        <div class=\"form-card\">\n          <h3 style=\"font-size: 1.35rem; font-weight: 900; margin-bottom: 4px;\">Schedule Service or Request Estimate</h3>\n          <p style=\"font-size: 0.85rem; color: #64748b; margin-bottom: 18px;\">Get a confirmed dispatch window in under 2 minutes.</p>\n          \n          <form onsubmit=\"handleFormSubmit(event)\">\n            <div class=\"form-group\">\n              <label>Full Name *</label>\n              <input type=\"text\" required class=\"form-control\" placeholder=\"John Doe\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Phone Number *</label>\n              <input type=\"tel\" required class=\"form-control\" placeholder=\"(555) 000-0000\" />\n            </div>\n\n            <div class=\"form-group\">\n              <label>Service Needed</label>\n              <select class=\"form-control\" id=\"service-select\">\n                <option value=\"repair\">Emergency AC / Furnace Repair</option>\n                <option value=\"tuneup\">21-Point System Tune-Up</option>\n                <option value=\"install\">Complete System Replacement</option>\n                <option value=\"maintenance\">Comfort Club Membership</option>\n              </select>\n            </div>\n\n            <div class=\"form-group\">\n              <label>Promo Code Applied</label>\n              <input type=\"text\" id=\"promo-input\" class=\"form-control\" value=\"SUMMER50\" readonly style=\"background:#f1f5f9; font-weight:bold; color:var(--primary);\" />\n            </div>\n\n            <button type=\"submit\" class=\"btn btn-primary\" style=\"width: 100%; min-height: 48px;\">\n              Redeem Coupon & Book Now\n            </button>\n            <p style=\"font-size:0.75rem; text-align:center; color:var(--text-muted); margin-top:8px;\">\360\237\224\222 No payment required until the job is complete.</p>\n          </form>\n        </div>"
